# Copy to .env.prod on the VPS and fill in real values.
# .env.prod is loaded two ways: docker-compose.prod.yml itself reads
# POSTGRES_PASSWORD/GHCR_OWNER/CADDY_NETWORK for its own variable substitution
# (${VAR} in that file), and the backend container also loads this file
# directly via `env_file:` for its own settings (SECRET_KEY, admin, CORS).
# See DEPLOY.md for the full setup walkthrough.

# --- used by docker-compose.prod.yml ---
POSTGRES_PASSWORD=change-me-to-a-long-random-value
GHCR_OWNER=laurentzo1992
# Name of the Docker network the kbbot-caddy container already lives on
# (see DEPLOY.md section 3). Confirmed via:
#   docker inspect kbbot-caddy --format "{{json .NetworkSettings.Networks}}"
CADDY_NETWORK=kbbot_backend

# Not read by docker-compose.prod.yml itself (PAGO has no Caddy of its own) -
# kept here as the single place documenting the public domain, since it's
# also needed below for CORS_ORIGINS and in Caddyfile.snippet.
DOMAIN=pago.logo-services.com

# --- used by the backend container (app/config.py) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
ADMIN_USERNAME=admin
# A NEW hash for production - do not reuse the one from backend/.env (dev).
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Double every $ so docker compose doesn't try to interpolate the hash itself,
# e.g. $2b$12$abc -> $$2b$$12$$abc
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=["https://pago.logo-services.com"]
