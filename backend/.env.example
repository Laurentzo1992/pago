DATABASE_URL=postgresql+psycopg://pago:pago@db:5432/pago
SECRET_KEY=change-me-to-a-random-string
ADMIN_USERNAME=admin
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# If setting this via a docker-compose env_file, double every $ (bcrypt hashes contain $) so
# Compose doesn't try to interpolate it, e.g. $2b$12$abc -> $$2b$$12$$abc
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=["http://localhost:5173","http://localhost"]
